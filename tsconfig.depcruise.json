{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["src/lib"],
      "$lib/*": ["src/lib/*"],
      "$workers": ["src/workers"],
      "$workers/*": ["src/workers/*"]
    }
  },
  "include": ["src/**/*"]
}
