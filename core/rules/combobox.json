          "selector": ".combobox-listbox",
          "open": true
        },
        {
          "selector": ".combobox .input",
          "references": {
            "aria-activedescendant": ".combobox-option:nth-child(3)"
          }
        },
        {
          "selector": ".combobox-option:nth-child(3)",
          "classes": {
            "is-selected": true
          }
        }
      ],
      "event": {
        "defaultPrevented": true
      },
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true
    },
    {
      "name": "moves the active option down on ArrowDown and wraps from the last to the first",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
        }
      ],
      "when": [
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        }
      ],
      "then": [
        {
          "selector": ".combobox .input",
          "references": {
            "aria-activedescendant": ".combobox-option:nth-child(1)"
          }
        },
        {
          "selector": ".combobox-option:nth-child(1)",
          "classes": {
            "is-selected": true
          }
        },
        {
          "selector": ".combobox-option:nth-child(3)",
          "classes": {
            "is-selected": false
          }
        }
      ],
      "event": {
        "defaultPrevented": true
      },
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "ArrowUp moves up and wraps from the first to the last. Home and End are left to the text field. Exactly one option carries is-selected, the one aria-activedescendant names."
    },
    {
      "name": "chooses the active option on Enter, writes its label into the field and closes the listbox",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
        }
      ],
      "when": [
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "keydown",
          "key": "Enter",
          "target": ".combobox .input"
