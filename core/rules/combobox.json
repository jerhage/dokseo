            "aria-expanded": "false",
            "aria-activedescendant": null
          }
        },
        {
          "selector": ".combobox .input",
          "properties": {
            "value": "Korean"
          },
          "focused": true
        },
        {
          "selector": ".combobox-option:nth-child(2)",
          "attributes": {
            "aria-selected": "true"
          },
          "classes": {
            "is-active": true
          }
        },
        {
          "selector": ".combobox-option:nth-child(1)",
          "attributes": {
            "aria-selected": "false"
          },
          "classes": {
            "is-active": false
          }
        }
      ],
      "emits": [
        {
          "callback": "onchoose",
          "with": "ko"
        }
      ],
      "event": {
        "defaultPrevented": true
      },
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "Choosing shows every option again: the filter applies only to text the user types, so the chosen markup is the fixture combobox/selected. Enter with no active option is left alone, so an enclosing form can submit."
    },
    {
      "name": "chooses an option on a click and keeps focus in the field",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
