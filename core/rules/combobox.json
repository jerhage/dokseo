{
  "component": "combobox",
  "behaviour": "native-script",
  "rules": [
    {
      "name": "opens the listbox and keeps only the options that match as text is typed",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
        }
      ],
      "when": [
        {
          "event": "input",
          "target": ".combobox .input",
          "value": "ko"
        }
      ],
      "then": [
        {
          "selector": ".combobox-listbox",
          "open": true,
          "style": {
            "--combobox-top": "set",
            "--combobox-left": "set",
            "--combobox-anchor-width": "set"
          }
        },
        {
          "selector": ".combobox .input",
          "attributes": {
            "aria-expanded": "true",
            "aria-activedescendant": null
          }
        },
        {
          "selector": ".combobox-option:nth-child(1)",
          "present": true
        },
        {
          "selector": ".combobox-option:nth-child(2)",
          "present": false
        }
      ],
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "An option matches when its label holds the typed text, both lower-cased with toLocaleLowerCase(); \"ko\" keeps Korean alone. Typing makes no option active. The listbox is a manual popover shown with showPopover(); its place is written to --combobox-top, --combobox-left and --combobox-anchor-width in px, below the field and at least as wide as it, as a dropdown menu is placed, and follows scroll and resize. The options are given as { value, label } pairs: here ja Japanese, ko Korean, en English."
    },
    {
      "name": "shows the empty message in the open listbox when no option matches",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
        }
      ],
      "when": [
        {
          "event": "input",
          "target": ".combobox .input",
          "value": "Latin"
        }
      ],
      "then": [
        {
          "selector": ".combobox-listbox",
          "open": true
        },
        {
          "selector": ".combobox-empty",
          "present": true
        },
        {
          "selector": ".combobox-option",
          "present": false
        }
      ],
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "The markup is the fixture combobox/empty. The message is a disabled option, so the listbox is never empty and the arrow keys skip it."
    },
    {
      "name": "opens the listbox and makes the first option active on ArrowDown, keeping focus in the field",
      "fixture": "combobox/default",
      "given": [
        {
          "selector": ".combobox .input",
          "focused": true
        }
      ],
      "when": [
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        }
      ],
      "then": [
        {
          "selector": ".combobox-listbox",
          "open": true
        },
        {
          "selector": ".combobox .input",
          "focused": true,
          "attributes": {
            "aria-expanded": "true"
          },
          "references": {
            "aria-activedescendant": ".combobox-option:nth-child(1)"
          }
        },
        {
          "selector": ".combobox-option:nth-child(1)",
          "classes": {
            "is-selected": true
          }
        }
      ],
      "event": {
        "defaultPrevented": true
      },
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "Alt+ArrowDown opens the listbox without making an option active. The active option is scrolled into view with scrollIntoView({ block: \"nearest\" })."
    },
    {
