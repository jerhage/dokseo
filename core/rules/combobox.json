          "target": ".combobox .input"
        }
      ],
      "then": [
        {
          "selector": ".combobox-listbox",
          "open": false
        },
        {
          "selector": ".combobox .input",
          "attributes": {
            "aria-expanded": "false",
            "aria-activedescendant": null
          }
        },
        {
          "selector": ".combobox .input",
          "properties": {
            "value": "Korean"
          }
        },
        {
          "selector": ".combobox-option:nth-child(2)",
          "attributes": {
            "aria-selected": "true"
          },
          "classes": {
            "is-active": true
          }
        }
      ],
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "Editing the text never changes the chosen option; only choosing one does, and the caller can set the value. With no option chosen, the field is emptied when focus leaves it with text that chooses nothing."
    }
