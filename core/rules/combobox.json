      "when": [
        {
          "event": "keydown",
          "key": "ArrowDown",
          "target": ".combobox .input"
        },
        {
          "event": "click",
          "target": ".combobox-option:nth-child(3)"
        }
      ],
      "then": [
        {
          "selector": ".combobox-listbox",
          "open": false
        },
        {
          "selector": ".combobox .input",
          "attributes": {
            "aria-expanded": "false",
            "aria-activedescendant": null
          }
        },
        {
          "selector": ".combobox .input",
          "properties": {
            "value": "English"
          },
          "focused": true
        },
        {
          "selector": ".combobox-option:nth-child(3)",
          "attributes": {
            "aria-selected": "true"
          },
          "classes": {
            "is-active": true
          }
        }
      ],
      "emits": [
        {
          "callback": "onchoose",
          "with": "en"
        }
      ],
      "source": "Combobox.svelte in kandan-ui-svelte, built to these rules",
      "certain": true,
      "note": "A pointerdown on an option is prevented, so the field never loses focus. Hovering an option does not make it active."
    },
    {
      "name": "closes the listbox on Escape and keeps the text",
