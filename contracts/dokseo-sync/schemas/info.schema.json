{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "info.schema.json",
  "title": "Info",
  "description": "Body of GET /v1/info.",
  "type": "object",
  "required": [
    "server",
    "version",
    "apiVersions"
  ],
  "properties": {
    "server": {
      "const": "dokseo-sync"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
