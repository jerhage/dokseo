{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "push-response.schema.json",
  "title": "Push response",
  "description": "Result of POST /v1/changes, in request order.",
  "type": "object",
  "required": [
    "accepted"
  ],
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "seq"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "The change id from the request."
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
